# Autolab project configuration
version: 1
directive: "{{ goal }}"

agent:
  backend: claude-code          # claude-code | openai | anthropic | openai-compatible
  # model: claude-opus-4-6
  # api_key_env: ANTHROPIC_API_KEY
  # base_url: http://localhost:11434/v1  # for openai-compatible

strategy:
  moonshot_ratio: 0.5
  moonshot_definition: >
    A moonshot campaign tests a fundamentally different approach,
    not an incremental variation of existing experiments.
    It should challenge core assumptions or explore orthogonal directions.
  enforce: soft                  # soft (advisory) | hard (scheduler enforces)

targets:
  min_campaigns: 50
  min_experiments: 500
